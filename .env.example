# CWT Macro Economics Sentiment Agent
# Copy this file to .env and fill in your API keys

# Apify Configuration
APIFY_TOKEN=your_apify_token_here
# APIFY_API_TOKEN is also supported as an alias
APIFY_API_TOKEN=your_apify_token_here

# Apify Actors (optional overrides)
APIFY_CALENDAR_PRIMARY=xtracto/forexfactory-calendar
APIFY_CALENDAR_BACKUP=bovi/forex-economic-calendar-scraper
APIFY_NEWS_HEADLINES=gazidev/google-news-scraper
APIFY_NEWS_FULL_TEXT=nourishing_courier/google-news-scraper

# Tavily Configuration  
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: OpenAI for macro summary generation
OPENAI_API_KEY=your_openai_key_here

# Database
DATABASE_URL=sqlite:///data/cwt_macro.db

# Pipeline Settings
LOOKBACK_DAYS=180
WALK_FORWARD_TRAIN_DAYS=120
WALK_FORWARD_TEST_DAYS=30
